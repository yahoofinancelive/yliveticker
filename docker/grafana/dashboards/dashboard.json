{
  "id": null,
  "uid": "yliveticker-dashboard",
  "title": "Yahoo Finance Live Ticker",
  "description": "Yahoo \u2192 yliveticker \u2192 InfluxDB \u2192 Grafana. DEMO-* symbols are synthetic test data.",
  "tags": [
    "yliveticker",
    "yahoo-finance",
    "market-data"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Latest price",
      "type": "stat",
      "description": "Last observed price in the selected range, in each symbol\u2019s quote currency.",
      "datasource": {
        "type": "influxdb",
        "uid": "yliveticker-influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.id}",
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "yliveticker-influxdb"
          },
          "query": "from(bucket: \"ticker_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\")\n  |> filter(fn: (r) => r.id =~ /^${symbol:regex}$/)\n  |> filter(fn: (r) => r._field == \"price\")\n  |> last()"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "title": "Time since last tick",
      "type": "stat",
      "description": "Age of the latest Yahoo timestamp in the selected range. Closed markets naturally become stale. No ticks in range means no data.",
      "datasource": {
        "type": "influxdb",
        "uid": "yliveticker-influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.id}",
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "noValue": "No ticks in range"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "yliveticker-influxdb"
          },
          "query": "from(bucket: \"ticker_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\")\n  |> filter(fn: (r) => r.id =~ /^${symbol:regex}$/)\n  |> filter(fn: (r) => r._field == \"price\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: uint(v: now()) - uint(v: r._time)) / 1000000000.0}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "${symbol}: price",
      "type": "timeseries",
      "description": "Last observed price per display window; panels repeat per selected symbol to keep independent price scales.",
      "datasource": {
        "type": "influxdb",
        "uid": "yliveticker-influxdb"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.id}",
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "yliveticker-influxdb"
          },
          "query": "from(bucket: \"ticker_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\")\n  |> filter(fn: (r) => r.id =~ /^${symbol:regex}$/)\n  |> filter(fn: (r) => r._field == \"price\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
        }
      ],
      "repeat": "symbol",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "${symbol}: session volume (cumulative)",
      "type": "timeseries",
      "description": "Yahoo dayVolume as received. This is cumulative session volume, not per-candle or interval volume.",
      "datasource": {
        "type": "influxdb",
        "uid": "yliveticker-influxdb"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.id}",
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "yliveticker-influxdb"
          },
          "query": "from(bucket: \"ticker_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\")\n  |> filter(fn: (r) => r.id =~ /^${symbol:regex}$/)\n  |> filter(fn: (r) => r._field == \"volume\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
        }
      ],
      "repeat": "symbol",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Symbols",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "yliveticker-influxdb"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"ticker_data\", tag: \"id\", predicate: (r) => r._measurement == \"ticker\", start: -1d)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": null,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  }
}
