{
  "id": null,
  "uid": "yliveticker-dashboard",
  "title": "yliveticker · Yahoo Finance",
  "description": "Live Yahoo Finance ticks are stored in InfluxDB 2 (ticker_data). DEMO-* prices appear only in explicit synthetic mode.",
  "tags": [
    "yliveticker",
    "yahoo-finance",
    "market-data"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "refresh": "5s",
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 5,
      "title": "Ticker dashboard · InfluxDB storage",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**The default collector streams live Yahoo Finance ticks into [InfluxDB](http://localhost:8086) · bucket `ticker_data`.** **`DEMO-*` symbols appear only when synthetic mode is explicitly enabled.** Select symbols above; charts refresh every 5 seconds.\n\nCharts empty? Allow startup to finish. Closed markets or an unavailable Yahoo feed can leave charts empty. [Quickstart and troubleshooting](https://github.com/yahoofinancelive/yliveticker/blob/feat/pooling-and-grafana/docker/README.md)."
      },
      "links": []
    },
    {
      "id": 6,
      "title": "Active feed (last 30 seconds)",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "yliveticker-influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Waiting for ticks",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Synthetic demo",
                  "color": "orange",
                  "index": 0
                },
                "0": {
                  "text": "Live Yahoo",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "yliveticker-influxdb"
          },
          "query": "from(bucket: \"ticker_data\")\n  |> range(start: -30s)\n  |> filter(fn: (r) => r._measurement == \"ticker\" and r._field == \"price\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 1)\n  |> map(fn: (r) => ({r with _value: if r.id =~ /^DEMO-/ then 1 else 0}))"
        }
      ]
    },
    {
      "id": 7,
      "title": "Stored ticks (selected range)",
      "description": "Price records read from InfluxDB; count excludes volume fields. Zero means no ticks have reached storage in this time range.",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "yliveticker-influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "yliveticker-influxdb"
          },
          "query": "from(bucket: \"ticker_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\" and r._field == \"price\")\n  |> group()\n  |> count()\n  |> map(fn: (r) => ({r with _time: now(), _field: \"stored_ticks\"}))"
        }
      ]
    },
    {
      "id": 1,
      "title": "Latest price",
      "type": "stat",
      "description": "Last observed price in the selected range, in each symbol’s quote currency.",
      "datasource": {
        "type": "influxdb",
        "uid": "yliveticker-influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.id}",
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "Waiting for ticks"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "yliveticker-influxdb"
          },
          "query": "from(bucket: \"ticker_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\")\n  |> filter(fn: (r) => r.id =~ /^${symbol:regex}$/)\n  |> filter(fn: (r) => r._field == \"price\")\n  |> last()"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "title": "Time since last tick",
      "type": "stat",
      "description": "Age of the latest Yahoo timestamp in the selected range. Closed markets naturally become stale. No ticks in range means no data.",
      "datasource": {
        "type": "influxdb",
        "uid": "yliveticker-influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.id}",
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "noValue": "Waiting for ticks"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "yliveticker-influxdb"
          },
          "query": "from(bucket: \"ticker_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\")\n  |> filter(fn: (r) => r.id =~ /^${symbol:regex}$/)\n  |> filter(fn: (r) => r._field == \"price\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: uint(v: now()) - uint(v: r._time)) / 1000000000.0}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "${symbol}: price",
      "type": "timeseries",
      "description": "Last observed price per display window; panels repeat per selected symbol to keep independent price scales.",
      "datasource": {
        "type": "influxdb",
        "uid": "yliveticker-influxdb"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.id}",
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "yliveticker-influxdb"
          },
          "query": "from(bucket: \"ticker_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\")\n  |> filter(fn: (r) => r.id =~ /^${symbol:regex}$/)\n  |> filter(fn: (r) => r._field == \"price\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
        }
      ],
      "repeat": "symbol",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "${symbol}: session volume (cumulative)",
      "type": "timeseries",
      "description": "Yahoo dayVolume as received. This is cumulative session volume, not per-candle or interval volume.",
      "datasource": {
        "type": "influxdb",
        "uid": "yliveticker-influxdb"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.id}",
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "yliveticker-influxdb"
          },
          "query": "from(bucket: \"ticker_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\")\n  |> filter(fn: (r) => r.id =~ /^${symbol:regex}$/)\n  |> filter(fn: (r) => r._field == \"volume\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
        }
      ],
      "repeat": "symbol",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Ticker dashboard",
      "type": "link",
      "url": "/d/yliveticker-dashboard",
      "targetBlank": false
    },
    {
      "title": "InfluxDB storage",
      "type": "link",
      "url": "http://localhost:8086",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Symbols",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "yliveticker-influxdb"
        },
        "query": "from(bucket: \"ticker_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ticker\" and r._field == \"price\")\n  |> map(fn: (r) => ({_value: r.id}))\n  |> group()\n  |> distinct()",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": null,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  }
}
